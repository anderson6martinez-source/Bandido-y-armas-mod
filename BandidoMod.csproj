<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BandidoMod</AssemblyName>
    <RootNamespace>Game</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
  </PropertyGroup>

  <!-- TODO en la RAIZ: se compilan todos los .cs que esten junto a este csproj -->
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!-- DLL del juego 2.4: ponelas en la RAIZ, junto a este csproj (si no estan, prueba en lib/) -->
  <ItemGroup>
    <Reference Include="Engine24.dll" Condition="Exists('Engine24.dll')"><Private>false</Private></Reference>
    <Reference Include="EntitySystem24.dll" Condition="Exists('EntitySystem24.dll')"><Private>false</Private></Reference>
    <Reference Include="Survivalcraft24.dll" Condition="Exists('Survivalcraft24.dll')"><Private>false</Private></Reference>
    <Reference Include="lib/Engine24.dll" Condition="!Exists('Engine24.dll') And Exists('lib/Engine24.dll')"><Private>false</Private></Reference>
    <Reference Include="lib/EntitySystem24.dll" Condition="!Exists('EntitySystem24.dll') And Exists('lib/EntitySystem24.dll')"><Private>false</Private></Reference>
    <Reference Include="lib/Survivalcraft24.dll" Condition="!Exists('Survivalcraft24.dll') And Exists('lib/Survivalcraft24.dll')"><Private>false</Private></Reference>
    <Reference Include="Lib/Engine24.dll" Condition="!Exists('Engine24.dll') And !Exists('lib/Engine24.dll') And Exists('Lib/Engine24.dll')"><Private>false</Private></Reference>
    <Reference Include="Lib/EntitySystem24.dll" Condition="!Exists('EntitySystem24.dll') And !Exists('lib/EntitySystem24.dll') And Exists('Lib/EntitySystem24.dll')"><Private>false</Private></Reference>
    <Reference Include="Lib/Survivalcraft24.dll" Condition="!Exists('Survivalcraft24.dll') And !Exists('lib/Survivalcraft24.dll') And Exists('Lib/Survivalcraft24.dll')"><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Despues de compilar: deja Bandido24.scmod en la RAIZ con los archivos de la raiz acomodados en sus carpetas -->
  <Target Name="EmpaquetarMod" AfterTargets="Build">
    <PropertyGroup>
      <StageDir>$(MSBuildProjectDirectory)/obj/stage/</StageDir>
      <DistDir>$(MSBuildProjectDirectory)/</DistDir>
      <ScmodPath>$(DistDir)Bandido24.scmod</ScmodPath>
    </PropertyGroup>

    <ItemGroup>
      <!-- raiz del scmod -->
      <ModRaiz Include="modinfo.json" />
      <ModRaiz Include="*.xdb" />
      <!-- Models/ -->
      <ModModelos Include="*.dae" />
      <!-- Textures/Items/ -->
      <ModItems Include="Pistola9mm.png" Condition="Exists('Pistola9mm.png')" />
      <ModItems Include="Bala9mm.png" Condition="Exists('Bala9mm.png')" />
      <!-- Textures/Creatures/ (la skin del bandido) -->
      <ModCriaturas Include="Bandido.png" Condition="Exists('Bandido.png')" />
      <!-- Audio/Creatures/ -->
      <ModAudio Include="*.wav" />
    </ItemGroup>

    <RemoveDir Directories="$(StageDir)" />
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="@(ModRaiz)"      DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="@(ModModelos)"   DestinationFolder="$(StageDir)Models/" />
    <Copy SourceFiles="@(ModItems)"     DestinationFolder="$(StageDir)Textures/Items/" />
    <Copy SourceFiles="@(ModCriaturas)" DestinationFolder="$(StageDir)Textures/Creatures/" />
    <Copy SourceFiles="@(ModAudio)"     DestinationFolder="$(StageDir)Audio/Creatures/" />
    <Copy SourceFiles="$(TargetPath)"   DestinationFolder="$(StageDir)" />

    <Delete Files="$(ScmodPath)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ScmodPath)" />
    <Message Importance="high" Text="Mod listo: $(ScmodPath)" />
  </Target>

</Project>
